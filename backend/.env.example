# Copy to backend/.env and fill in. backend/.env is git-ignored — never commit real values.
# docker compose reads this file automatically when run from backend/.

# Keycloak client secret for client "chessid" (Keycloak admin console -> Clients -> chessid -> Credentials)
KEYCLOAK_CLIENT_SECRET=
# Keycloak bootstrap admin password (user "chessnewadmin")
KEYCLOAK_ADMIN_PASSWORD=
# Gmail app password for ChessMystic.mail@gmail.com (Google Account -> Security -> App passwords)
GMAIL_PASSWORD=
# Hugging Face access token used by the AI model service
HUGGINGFACE_TOKEN=

# Optional — dev defaults are used when unset
POSTGRES_PASSWORD=keycloak_password
MONGO_PASSWORD=mongo_password
